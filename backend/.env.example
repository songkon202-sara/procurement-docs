# In production (e.g. Supabase), DATABASE_URL is the pooled connection and DIRECT_URL is the
# direct one Prisma migrations need. Locally there's no pooler, so both point at the same DB.
DATABASE_URL="postgresql://procurement:procurement@localhost:5432/procurement_docs?schema=public"
DIRECT_URL="postgresql://procurement:procurement@localhost:5432/procurement_docs?schema=public"
PORT=3001
# Generate a real secret for anything beyond local dev: openssl rand -base64 48
JWT_SECRET="dev-only-change-me"
CORS_ORIGIN="http://localhost:5173"
