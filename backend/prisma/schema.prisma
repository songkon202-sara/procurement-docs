generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================================
// Organizations — รองรับหลายหน่วยงานในอนาคต แม้ปัจจุบันจะมีหน่วยงานเดียว
// ==========================================================
model Organization {
  id        String   @id @default(uuid())
  name      String
  district  String?
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  users            User[]
  vendors          Vendor[]
  procurementCases ProcurementCase[]
  documentNumbers  DocumentNumber[]

  @@map("organizations")
}

// ==========================================================
// RBAC — roles เป็นตาราง ไม่ hardcode enum เพื่อขยายสิทธิ์ได้โดยไม่ต้อง migration schema
// ==========================================================
model Role {
  id          Int    @id @default(autoincrement())
  code        String @unique // 'procurement_officer' | 'auditor' | 'approver' | 'admin' | 'viewer'
  nameTh      String @map("name_th")
  description String?

  userRoles UserRole[]

  @@map("roles")
}

model User {
  id                String   @id @default(uuid())
  orgId             String   @map("org_id")
  employeeCode      String?  @map("employee_code")
  fullName          String   @map("full_name")
  position          String
  email             String   @unique
  passwordHash      String   @map("password_hash")
  signatureImageUrl String?  @map("signature_image_url")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  org               Organization      @relation(fields: [orgId], references: [id])
  roles             UserRole[]
  ownedCases        ProcurementCase[] @relation("CaseOwner")
  approvalsActed    CaseApproval[]
  auditEntries      AuditLog[]

  @@map("users")
}

model UserRole {
  userId    String   @map("user_id")
  roleId    Int      @map("role_id")
  grantedBy String?  @map("granted_by")
  grantedAt DateTime @default(now()) @map("granted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

// ==========================================================
// Vendors — master data ของผู้ขาย/ผู้รับจ้าง (แทนช่อง vendorName/vendorTaxId แบบ free text เดิม)
// ==========================================================
model Vendor {
  id               String   @id @default(uuid())
  orgId            String   @map("org_id")
  legalName        String   @map("legal_name")
  taxId            String   @unique @map("tax_id")
  contactName      String?  @map("contact_name")
  phone            String?
  address          String?
  isBlacklisted    Boolean  @default(false) @map("is_blacklisted") // ผู้ทิ้งงาน ม.109
  blacklistReason  String?  @map("blacklist_reason")
  blacklistRef     String?  @map("blacklist_ref")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  org   Organization      @relation(fields: [orgId], references: [id])
  cases ProcurementCase[]

  @@map("vendors")
}

// ==========================================================
// Procurement cases — แทน SavedProject เดิม, แกนกลางของระบบ
// ==========================================================
model ProcurementCase {
  id                      String   @id @default(uuid())
  orgId                   String   @map("org_id")
  category                String   // 'purchase' | 'hire' | 'construction'
  projectName             String   @map("project_name")
  method                  String   // วิธีจัดซื้อจัดจ้าง
  legalRef                String   @map("legal_ref")
  amount                  Decimal  @db.Decimal(14, 2)
  fundSource              String?  @map("fund_source")
  vendorId                String?  @map("vendor_id")
  status                  String   @default("draft")
  ownerId                 String   @map("owner_id")
  thresholdOverrideReason String?  @map("threshold_override_reason")
  formData                Json     @default("{}") @map("form_data")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  org             Organization     @relation(fields: [orgId], references: [id])
  vendor          Vendor?          @relation(fields: [vendorId], references: [id])
  owner           User             @relation("CaseOwner", fields: [ownerId], references: [id])
  members         CaseMember[]
  lineItems       CaseLineItem[]
  approvals       CaseApproval[]
  documentNumbers DocumentNumber[]

  @@index([orgId, status])
  @@index([vendorId])
  @@map("procurement_cases")
}

// ==========================================================
// Document numbers — ทะเบียนเลขที่หนังสือ กันเลขซ้ำทั้งหน่วยงาน
// ==========================================================
model DocumentNumber {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  caseId      String   @map("case_id")
  docId       String   @map("doc_id") // 'approveReq' | 'memo' | 'priceReport' | 'report' | 'approve' | 'inspectReport' | 'payReq'
  runningNo   Int      @map("running_no")
  docNo       String   @map("doc_no")
  docDate     DateTime @map("doc_date") @db.Date
  fiscalYear  Int      @map("fiscal_year")

  org  Organization    @relation(fields: [orgId], references: [id])
  case ProcurementCase @relation(fields: [caseId], references: [id])

  @@unique([orgId, fiscalYear, runningNo])
  @@index([caseId])
  @@map("document_numbers")
}

// ==========================================================
// Case members — แทน PersonRow[] (คณะกรรมการ / ผู้ตรวจรับ)
// ==========================================================
model CaseMember {
  id           String  @id @default(uuid())
  caseId       String  @map("case_id")
  kind         String  // 'committee' | 'inspectors'
  userId       String? @map("user_id")
  externalName String? @map("external_name")
  position     String
  roleLabel    String  @map("role_label") // 'ประธานกรรมการ' / 'กรรมการ'
  sortOrder    Int     @default(0) @map("sort_order")

  case ProcurementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_members")
}

// ==========================================================
// Case line items — แทน LineItem[]
// ==========================================================
model CaseLineItem {
  id        String  @id @default(uuid())
  caseId    String  @map("case_id")
  name      String
  qty       Decimal @db.Decimal(12, 2)
  unit      String
  unitPrice Decimal @map("unit_price") @db.Decimal(14, 2)
  sortOrder Int     @default(0) @map("sort_order")

  case ProcurementCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@map("case_line_items")
}

// ==========================================================
// Case approvals — append-only workflow log (ห้าม UPDATE ทับประวัติ)
// ==========================================================
model CaseApproval {
  id      String   @id @default(uuid())
  caseId  String   @map("case_id")
  actorId String   @map("actor_id")
  action  String   // 'submit' | 'review_pass' | 'review_reject' | 'approve' | 'reject' | 'reopen' | 'complete' | 'cancel'
  comment String?
  actedAt DateTime @default(now()) @map("acted_at")

  case  ProcurementCase @relation(fields: [caseId], references: [id])
  actor User            @relation(fields: [actorId], references: [id])

  @@index([caseId, actedAt])
  @@map("case_approvals")
}

// ==========================================================
// Audit log — generic, immutable, ครอบทุก entity (security/compliance requirement)
// ==========================================================
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id")
  actorIp    String?  @map("actor_ip")
  entityType String   @map("entity_type") // 'procurement_case' | 'vendor' | 'user' | ...
  entityId   String   @map("entity_id")
  action     String   // 'create' | 'update' | 'delete' | 'export_word' | 'login' | ...
  beforeData Json?    @map("before_data")
  afterData  Json?    @map("after_data")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("audit_log")
}
